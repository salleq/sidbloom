{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SIDbloom",
  "version": "0.1.0",
  "identifier": "io.github.salleq.sidbloom",
  "build": {
    "beforeDevCommand": "npm --prefix app run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix app ci && npm --prefix app run wasm && npm --prefix app run build",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [
      { "title": "SIDbloom", "width": 1440, "height": 900, "minWidth": 900, "minHeight": 600 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Modern 3-channel SID music tracker",
    "license": "GPL-3.0-or-later",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
