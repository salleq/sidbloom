  "type": "module",
  "scripts": {
    "wasm": "cd .. && cargo build -p sidbloom-wasm --target wasm32-unknown-unknown --release && wasm-bindgen --target web --out-dir app/src/wasm target/wasm32-unknown-unknown/release/sidbloom_wasm.wasm",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
